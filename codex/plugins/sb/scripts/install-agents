#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
plugin_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
source_dir="$plugin_root/assets/agents"
target_root=${CODEX_HOME:-"$HOME/.codex"}
target_dir="$target_root/agents"
state_dir="$target_root/sb/state"
manifest_file="$state_dir/installed-agents.sha256"
legacy_snapshot_dir="$target_root/sb/installed-agents"
profiles='sb-worker sb-explorer sb-thinker'
mode=${1:---install}

case "$target_root" in
  ''|'/')
    printf '%s\n' "Refusing unsafe Codex home: $target_root" >&2
    exit 2
    ;;
esac

for profile in $profiles; do
  source_file="$source_dir/$profile.toml"
  if [ ! -f "$source_file" ]; then
    printf '%s\n' "Missing bundled agent: $source_file" >&2
    exit 1
  fi
done

hash_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
    return
  fi

  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
    return
  fi

  printf '%s\n' 'Missing SHA-256 command: expected sha256sum or shasum.' >&2
  return 1
}

installed_hash() {
  if [ ! -f "$manifest_file" ]; then
    return
  fi

  awk -v expected="$1.toml" '$2 == expected { print $1; exit }' "$manifest_file"
}

check_conflicts() {
  conflicts=0
  for profile in $profiles; do
    source_file="$source_dir/$profile.toml"
    target_file="$target_dir/$profile.toml"
    legacy_snapshot_file="$legacy_snapshot_dir/$profile.toml"

    if [ ! -e "$target_file" ] || cmp -s "$target_file" "$source_file"; then
      continue
    fi

    current_hash=$(hash_file "$target_file")
    previous_hash=$(installed_hash "$profile")
    if [ -n "$previous_hash" ] && [ "$current_hash" = "$previous_hash" ]; then
      continue
    fi

    if [ -f "$legacy_snapshot_file" ] && cmp -s "$target_file" "$legacy_snapshot_file"; then
      continue
    fi

    printf '%s\n' "Conflict: $target_file differs from the last SB-installed copy." >&2
    conflicts=1
  done

  if [ "$conflicts" -ne 0 ]; then
    printf '%s\n' 'No agent files were changed.' >&2
    return 1
  fi
}

write_manifest() {
  mkdir -p "$state_dir"
  temporary_manifest="$manifest_file.tmp.$$"
  trap 'rm -f "$temporary_manifest"' 0 1 2 15
  : > "$temporary_manifest"

  for profile in $profiles; do
    source_file="$source_dir/$profile.toml"
    printf '%s  %s.toml\n' "$(hash_file "$source_file")" "$profile" >> "$temporary_manifest"
  done

  chmod 0644 "$temporary_manifest"
  mv "$temporary_manifest" "$manifest_file"
  trap - 0 1 2 15
}

remove_legacy_snapshots() {
  for profile in $profiles; do
    rm -f "$legacy_snapshot_dir/$profile.toml"
  done
  rmdir "$legacy_snapshot_dir" 2>/dev/null || true
}

case "$mode" in
  --preflight)
    check_conflicts
    ;;
  --install)
    check_conflicts
    mkdir -p "$target_dir"
    for profile in $profiles; do
      source_file="$source_dir/$profile.toml"
      target_file="$target_dir/$profile.toml"
      cp "$source_file" "$target_file"
      chmod 0644 "$target_file"
    done
    write_manifest
    remove_legacy_snapshots
    printf '%s\n' "Installed namespaced agents in $target_dir."
    ;;
  --check)
    for profile in $profiles; do
      source_file="$source_dir/$profile.toml"
      target_file="$target_dir/$profile.toml"
      if [ ! -f "$target_file" ] || ! cmp -s "$target_file" "$source_file"; then
        printf '%s\n' "Agent is missing or stale: $target_file" >&2
        exit 1
      fi
      if [ "$(installed_hash "$profile")" != "$(hash_file "$source_file")" ]; then
        printf '%s\n' "Agent install state is missing or stale: $manifest_file" >&2
        exit 1
      fi
    done
    printf '%s\n' "Verified namespaced agents in $target_dir."
    ;;
  *)
    printf '%s\n' 'Usage: install-agents [--preflight|--install|--check]' >&2
    exit 2
    ;;
esac
