#!/bin/sh
set -eu

LOCK_MAX_ATTEMPTS=30
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
plugin_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
source_file="$plugin_root/assets/bin/sb-notes"
target_root=${CODEX_HOME:-"$HOME/.codex"}
mode=${1:---install}
target_dir=''
target_file=''
state_dir=''
manifest_file=''
installer_lock=''
temporary_helper=''
temporary_manifest=''
previous_helper=''
previous_manifest=''

die() {
  printf '%s\n' "install-sb-notes: $*" >&2
  exit 1
}

release_lock() {
  if [ -n "$installer_lock" ]; then
    rm -f "$installer_lock/owner.pid"
    rmdir "$installer_lock" 2>/dev/null || true
    installer_lock=''
  fi
}

cleanup() {
  status=$?
  trap - 0 1 2 15
  [ -z "$temporary_helper" ] || rm -f "$temporary_helper"
  [ -z "$temporary_manifest" ] || rm -f "$temporary_manifest"
  [ -z "$previous_helper" ] || rm -f "$previous_helper"
  [ -z "$previous_manifest" ] || rm -f "$previous_manifest"
  release_lock
  exit "$status"
}

trap 'cleanup' 0 1 2 15

case "$target_root" in
  ''|'/') die "refusing unsafe Codex home: $target_root" ;;
  /*) ;;
  *) die "Codex home must be absolute: $target_root" ;;
esac
case "$target_root" in
  *'
'*|*''*) die "Codex home must be a single line: $target_root" ;;
esac

[ -f "$source_file" ] && [ ! -L "$source_file" ] || die "missing bundled helper: $source_file"

canonical_dir() {
  CDPATH= cd -- "$1" && pwd -P
}

assert_inside_home() {
  candidate=$1
  case "$candidate/" in
    "$canonical_home/"*) ;;
    *) die "destination escapes CODEX_HOME: $candidate" ;;
  esac
}

hash_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
    return
  fi

  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
    return
  fi

  die 'missing SHA-256 command: expected sha256sum or shasum'
}

resolve_home() {
  create_home=$1
  if [ "$create_home" = yes ] && [ ! -e "$target_root" ]; then
    mkdir -p "$target_root" || die "cannot create Codex home: $target_root"
  fi
  [ -d "$target_root" ] || die "Codex home is unavailable: $target_root"
  [ ! -L "$target_root" ] || die "refusing symlinked Codex home: $target_root"
  canonical_home=$(canonical_dir "$target_root") || die "cannot resolve Codex home: $target_root"
}

ensure_directory() {
  directory=$1
  description=$2
  [ ! -L "$directory" ] || die "refusing symlinked $description: $directory"
  if [ ! -d "$directory" ]; then
    if mkdir "$directory" 2>/dev/null; then
      :
    elif [ ! -d "$directory" ]; then
      die "cannot create $description: $directory"
    fi
  fi
  [ -d "$directory" ] || die "$description is not a directory: $directory"
  [ ! -L "$directory" ] || die "refusing symlinked $description: $directory"
}

require_directory() {
  directory=$1
  description=$2
  [ -d "$directory" ] || die "$description is unavailable: $directory"
  [ ! -L "$directory" ] || die "refusing symlinked $description: $directory"
}

validate_target_file() {
  [ ! -L "$target_file" ] || die "refusing symlinked helper target: $target_file"
  if [ -e "$target_file" ]; then
    [ -f "$target_file" ] || die "helper target is not a regular file: $target_file"
  fi
}

validate_manifest_file() {
  [ ! -L "$manifest_file" ] || die "refusing symlinked helper manifest: $manifest_file"
  if [ -e "$manifest_file" ]; then
    [ -f "$manifest_file" ] || die "helper manifest is not a regular file: $manifest_file"
  fi
}

set_helper_destination() {
  target_dir="$canonical_home/bin"
  canonical_target_dir=$(canonical_dir "$target_dir") || die "cannot resolve helper directory: $target_dir"
  assert_inside_home "$canonical_target_dir"
  target_dir=$canonical_target_dir
  target_file="$target_dir/sb-notes"
}

set_manifest_destination() {
  state_dir="$canonical_home/sb/state"
  canonical_state_dir=$(canonical_dir "$state_dir") || die "cannot resolve SB state directory: $state_dir"
  assert_inside_home "$canonical_state_dir"
  state_dir=$canonical_state_dir
  manifest_file="$state_dir/installed-sb-notes.sha256"
}

prepare_destinations() {
  resolve_home yes
  ensure_directory "$canonical_home/bin" 'helper directory'
  set_helper_destination
  ensure_directory "$canonical_home/sb" 'SB state directory'
  ensure_directory "$canonical_home/sb/state" 'SB state directory'
  set_manifest_destination
  validate_target_file
  validate_manifest_file
}

resolve_existing_destinations() {
  resolve_home no
  require_directory "$canonical_home/bin" 'helper directory'
  set_helper_destination
  require_directory "$canonical_home/sb" 'SB state directory'
  require_directory "$canonical_home/sb/state" 'SB state directory'
  set_manifest_destination
  validate_target_file
  validate_manifest_file
}

installed_hash() {
  if [ -f "$manifest_file" ]; then
    sed -n 's/^sha256=//p' "$manifest_file" | head -n 1
  fi
}

check_conflict() {
  validate_target_file
  validate_manifest_file
  if [ ! -e "$target_file" ] || cmp -s "$target_file" "$source_file"; then
    return
  fi

  current_hash=$(hash_file "$target_file")
  previous_hash=$(installed_hash)
  if [ -n "$previous_hash" ] && [ "$current_hash" = "$previous_hash" ]; then
    return
  fi

  die "conflict: $target_file differs from the last SB-installed helper; the helper was not changed"
}

acquire_lock() {
  lock_path="$state_dir/.install-sb-notes.lock"
  attempt=1
  while ! mkdir "$lock_path" 2>/dev/null; do
    [ ! -L "$lock_path" ] || die "refusing symlinked installer lock: $lock_path"
    [ -d "$lock_path" ] || die "cannot reserve installer lock: $lock_path"
    if [ "$attempt" -ge "$LOCK_MAX_ATTEMPTS" ]; then
      die "installer lock is still held: $lock_path; inspect it after confirming no installer is active"
    fi
    attempt=$((attempt + 1))
    sleep 1
  done
  installer_lock=$lock_path
  printf '%s\n' "$$" > "$installer_lock/owner.pid" || die "cannot record installer lock owner: $installer_lock"
  chmod 600 "$installer_lock/owner.pid" || die "cannot secure installer lock: $installer_lock"
}

stage_helper() {
  temporary_helper=$(mktemp "$target_dir/.sb-notes.XXXXXX") || die "cannot stage helper in $target_dir"
  cp "$source_file" "$temporary_helper" || die "cannot stage helper: $source_file"
  chmod 0755 "$temporary_helper" || die "cannot make staged helper executable: $temporary_helper"
  cmp -s "$source_file" "$temporary_helper" || die "staged helper verification failed: $temporary_helper"
}

stage_manifest() {
  source_hash=$(hash_file "$source_file")
  temporary_manifest=$(mktemp "$state_dir/.installed-sb-notes.sha256.XXXXXX") || die "cannot stage helper manifest in $state_dir"
  printf 'sha256=%s\n' "$source_hash" > "$temporary_manifest" || die "cannot write helper manifest: $temporary_manifest"
  chmod 600 "$temporary_manifest" || die "cannot secure helper manifest: $temporary_manifest"
  [ "$(sed -n 's/^sha256=//p' "$temporary_manifest")" = "$source_hash" ] || die "staged helper manifest verification failed: $temporary_manifest"
}

stage_previous_files() {
  if [ -e "$target_file" ]; then
    previous_helper=$(mktemp "$target_dir/.sb-notes.rollback.XXXXXX") || die "cannot stage helper rollback file in $target_dir"
    cp -p "$target_file" "$previous_helper" || die "cannot stage previous helper: $target_file"
  fi
  if [ -e "$manifest_file" ]; then
    previous_manifest=$(mktemp "$state_dir/.installed-sb-notes.sha256.rollback.XXXXXX") || die "cannot stage manifest rollback file in $state_dir"
    cp -p "$manifest_file" "$previous_manifest" || die "cannot stage previous helper manifest: $manifest_file"
  fi
}

discard_previous_files() {
  [ -z "$previous_helper" ] || rm -f "$previous_helper"
  [ -z "$previous_manifest" ] || rm -f "$previous_manifest"
  previous_helper=''
  previous_manifest=''
}

rollback_helper() {
  if [ -n "$previous_helper" ]; then
    mv "$previous_helper" "$target_file" || return 1
    previous_helper=''
  else
    rm -f "$target_file" || return 1
  fi
}

rollback_manifest() {
  if [ -n "$previous_manifest" ]; then
    if [ -f "$manifest_file" ] && cmp -s "$previous_manifest" "$manifest_file"; then
      rm -f "$previous_manifest" || return 1
      previous_manifest=''
      return
    fi
    mv "$previous_manifest" "$manifest_file" || return 1
    previous_manifest=''
  elif [ -e "$manifest_file" ]; then
    rm -f "$manifest_file" || return 1
  fi
}

publish_staged_files() {
  mv "$temporary_helper" "$target_file" || die "cannot publish helper: $target_file"
  temporary_helper=''
  if mv "$temporary_manifest" "$manifest_file"; then
    temporary_manifest=''
    discard_previous_files
    return
  fi

  rollback_helper || die "cannot publish helper manifest and cannot roll back helper: $manifest_file"
  rollback_manifest || die "cannot publish helper manifest and cannot preserve prior manifest: $manifest_file"
  die "cannot publish helper manifest; previous helper and manifest were preserved: $manifest_file"
}

case "$mode" in
  --preflight)
    prepare_destinations
    acquire_lock
    check_conflict
    release_lock
    ;;
  --install)
    prepare_destinations
    acquire_lock
    check_conflict
    stage_helper
    stage_manifest
    stage_previous_files
    publish_staged_files
    release_lock
    printf '%s\n' "Installed sb-notes in $target_file."
    ;;
  --check)
    resolve_existing_destinations
    if [ ! -f "$target_file" ] || ! cmp -s "$target_file" "$source_file"; then
      die "sb-notes is missing or stale: $target_file"
    fi
    if [ "$(installed_hash)" != "$(hash_file "$source_file")" ]; then
      die "sb-notes install state is missing or stale: $manifest_file"
    fi
    printf '%s\n' "Verified sb-notes in $target_file."
    ;;
  *)
    printf '%s\n' 'Usage: install-sb-notes [--preflight|--install|--check]' >&2
    exit 2
    ;;
esac
