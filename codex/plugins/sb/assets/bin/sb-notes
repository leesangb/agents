#!/bin/sh
set -eu

STATE_MAX_BYTES=24576
CHECKPOINT_MAX_BYTES=16384
LOCK_MAX_ATTEMPTS=30
temporary_state=''
creating_task=''
held_lock=''
held_layout_lock=''
held_layout_lock_token=''
temporary_checkpoint=''
temporary_layout_lock=''
temporary_layout_reclaimer=''
temporary_reservation_token=''
migration_transaction=''

die() {
  printf '%s\n' "sb-notes: $*" >&2
  exit 1
}

release_lock() {
  if [ -n "$held_lock" ]; then
    rm -f "$held_lock/owner.pid"
    rmdir "$held_lock" 2>/dev/null || true
    held_lock=''
  fi
}

release_layout_lock() {
  if [ -n "$held_layout_lock" ]; then
    if layout_lock_is_owned_by "$held_layout_lock" "$held_layout_lock_token"; then
      rm -f "$held_layout_lock"
    fi
    held_layout_lock=''
    held_layout_lock_token=''
  fi
}

cleanup() {
  status=$?
  trap - 0 1 2 15
  if [ -n "$temporary_state" ]; then
    rm -f "$temporary_state"
  fi
  if [ -n "$creating_task" ]; then
    rm -rf "$creating_task"
  fi
  if [ -n "$temporary_checkpoint" ]; then
    rm -f "$temporary_checkpoint"
  fi
  if [ -n "$temporary_layout_lock" ]; then
    rm -f "$temporary_layout_lock"
  fi
  if [ -n "$temporary_layout_reclaimer" ]; then
    rm -f "$temporary_layout_reclaimer"
  fi
  if [ -n "$temporary_reservation_token" ]; then
    rm -f "$temporary_reservation_token"
  fi
  recover_current_migration
  release_lock
  release_layout_lock
  exit "$status"
}

trap 'cleanup' 0
trap 'exit 129' 1
trap 'exit 130' 2
trap 'exit 143' 15

usage() {
  cat >&2 <<'EOF'
Usage:
  sb-notes init [--task-id ID] [--title TITLE] [--status STATUS] [--areas TEXT] [--risk TEXT]
  sb-notes resolve --task-path ABSOLUTE_TASK_PATH
  sb-notes read-state --task-path ABSOLUTE_TASK_PATH
  sb-notes replace-state --task-path ABSOLUTE_TASK_PATH --expected-hash SHA256 --file STATE_FILE
  sb-notes checkpoint --task-path ABSOLUTE_TASK_PATH --kind KIND --actor ACTOR --input-sha SHA --output-sha SHA --file BODY_FILE
  sb-notes artifact --task-path ABSOLUTE_TASK_PATH --name NAME --path ABSOLUTE_ARTIFACT_PATH
  sb-notes migrate-layout --dry-run|--execute
EOF
  exit 2
}

need_value() {
  [ "$#" -ge 2 ] || die "missing value for $1"
}

canonical_dir() {
  CDPATH= cd -- "$1" && pwd -P
}

file_size() {
  wc -c < "$1" | tr -d ' '
}

file_mode() {
  if stat -f '%Lp' "$1" >/dev/null 2>&1; then
    stat -f '%Lp' "$1"
  else
    stat -c '%a' "$1"
  fi
}

hash_text() {
  if command -v sha256sum >/dev/null 2>&1; then
    printf '%s' "$1" | sha256sum | awk '{print $1}'
    return
  fi

  if command -v shasum >/dev/null 2>&1; then
    printf '%s' "$1" | shasum -a 256 | awk '{print $1}'
    return
  fi

  die 'missing SHA-256 command: expected sha256sum or shasum'
}

hash_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
    return
  fi

  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
    return
  fi

  die 'missing SHA-256 command: expected sha256sum or shasum'
}

short_hash() {
  hash_text "$1" | cut -c 1-12
}

slug() {
  value=$(printf '%s' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C sed 's/[^a-z0-9][^a-z0-9]*/-/g; s/^-//; s/-$//' | cut -c 1-48)
  if [ -n "$value" ]; then
    printf '%s\n' "$value"
  else
    printf '%s\n' 'task'
  fi
}

require_single_line() {
  case "$2" in
    *'
'*|*''*) die "$1 must be a single line" ;;
  esac
}

require_short_text() {
  require_single_line "$1" "$2"
  size=$(printf '%s' "$2" | wc -c | tr -d ' ')
  [ "$size" -le 240 ] || die "$1 is too long"
}

yaml_quote() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

metadata_value() {
  key=$1
  file=$2
  sed -n "s/^$key=//p" "$file" | head -n 1
}

metadata_files() {
  find "$1" -type f -name metadata.env -print | LC_ALL=C sort
}

ensure_private_directory() {
  directory=$1
  if [ -L "$directory" ]; then
    die "refusing symlinked notes directory: $directory"
  fi
  if [ ! -d "$directory" ]; then
    if mkdir "$directory" 2>/dev/null; then
      chmod 700 "$directory" || die "cannot secure notes directory: $directory"
    elif [ ! -d "$directory" ]; then
      die "cannot create notes directory: $directory"
    fi
  fi
  [ ! -L "$directory" ] || die "refusing symlinked notes directory: $directory"
  chmod 700 "$directory" || die "cannot secure notes directory: $directory"
}

acquire_lock() {
  lock_path=$1
  lock_parent=$(dirname "$lock_path")
  ensure_private_directory "$lock_parent"
  attempt=1
  while ! mkdir "$lock_path" 2>/dev/null; do
    [ -d "$lock_path" ] || die "cannot reserve task lock: $lock_path"
    if [ "$attempt" -ge "$LOCK_MAX_ATTEMPTS" ]; then
      die "task lock is still held or incomplete: $lock_path; inspect or remove it after confirming no sb-notes process is active"
    fi
    attempt=$((attempt + 1))
    sleep 1
  done
  held_lock=$lock_path
  printf '%s\n' "$$" > "$held_lock/owner.pid" || die "cannot record task lock owner: $held_lock"
  chmod 600 "$held_lock/owner.pid" || die "cannot secure task lock: $held_lock"
}

acquire_layout_lock() {
  layout_root=$1
  layout_lock="$layout_root/.sb-notes-layout.lock"
  temporary_layout_lock=$(mktemp "$layout_root/.sb-notes-layout-lock.XXXXXX") || die "cannot stage layout coordination lock: $layout_root"
  held_layout_lock_token=$(basename "$temporary_layout_lock")
  printf '%s\n%s\n' "$$" "$held_layout_lock_token" > "$temporary_layout_lock" || die "cannot record layout coordination lock owner: $layout_root"
  chmod 600 "$temporary_layout_lock" || die "cannot secure layout coordination lock: $layout_root"
  attempt=1
  while :; do
    layout_reclaimer="$layout_lock.reclaim"
    if [ -e "$layout_reclaimer" ] || [ -L "$layout_reclaimer" ]; then
      if [ "$attempt" -ge "$LOCK_MAX_ATTEMPTS" ]; then
        die "layout stale-reclaimer is still active: $layout_reclaimer; inspect it after confirming no sb-notes process is active"
      fi
      attempt=$((attempt + 1))
      sleep 1
      continue
    fi
    if ln "$temporary_layout_lock" "$layout_lock" 2>/dev/null; then
      break
    fi
    [ -f "$layout_lock" ] && [ ! -L "$layout_lock" ] || die "cannot reserve layout coordination lock: $layout_lock"
    if reclaim_stale_layout_lock "$layout_lock"; then
      continue
    fi
    if [ "$attempt" -ge "$LOCK_MAX_ATTEMPTS" ]; then
      die "layout coordination lock is still held: $layout_lock; wait for the active sb-notes operation to finish"
    fi
    attempt=$((attempt + 1))
    sleep 1
  done
  rm -f "$temporary_layout_lock"
  temporary_layout_lock=''
  held_layout_lock=$layout_lock
}

layout_lock_owner_record() {
  layout_lock=$1
  layout_lock_owner_pid=''
  layout_lock_owner_token=''
  [ -f "$layout_lock" ] && [ ! -L "$layout_lock" ] || return 1
  layout_lock_owner_pid=$(sed -n '1p' "$layout_lock")
  layout_lock_owner_lines=$(wc -l < "$layout_lock" | tr -d ' ')
  printf '%s' "$layout_lock_owner_pid" | grep -Eq '^[1-9][0-9]*$' || return 1
  case "$layout_lock_owner_lines" in
    1) return 0 ;;
    2)
      layout_lock_owner_token=$(sed -n '2p' "$layout_lock")
      printf '%s' "$layout_lock_owner_token" | grep -Eq '^[A-Za-z0-9._-]+$'
      ;;
    *) return 1 ;;
  esac
}

layout_lock_is_owned_by() {
  layout_lock=$1
  expected_layout_token=$2
  [ -n "$expected_layout_token" ] || return 1
  layout_lock_owner_record "$layout_lock" || return 1
  [ "$layout_lock_owner_token" = "$expected_layout_token" ]
}

same_regular_file() {
  first_file=$1
  second_file=$2
  [ -f "$first_file" ] && [ ! -L "$first_file" ] || return 1
  [ -f "$second_file" ] && [ ! -L "$second_file" ] || return 1
  if stat -f '%d:%i' "$first_file" >/dev/null 2>&1; then
    first_identity=$(stat -f '%d:%i' "$first_file")
    second_identity=$(stat -f '%d:%i' "$second_file")
  else
    first_identity=$(stat -c '%d:%i' "$first_file") || return 1
    second_identity=$(stat -c '%d:%i' "$second_file") || return 1
  fi
  [ "$first_identity" = "$second_identity" ]
}

reclaim_stale_layout_lock() {
  layout_lock=$1
  layout_lock_owner_record "$layout_lock" || return 1
  owner_pid=$layout_lock_owner_pid
  owner_token=$layout_lock_owner_token
  kill -0 "$owner_pid" 2>/dev/null && return 1
  command -v ps >/dev/null 2>&1 || return 1
  owner_process=$(ps -p "$owner_pid" -o pid= 2>&1)
  owner_process_status=$?
  [ -z "$owner_process" ] || return 1
  [ "$owner_process_status" = 1 ] || return 1
  layout_reclaimer="$layout_lock.reclaim"
  [ ! -e "$layout_reclaimer" ] && [ ! -L "$layout_reclaimer" ] || return 1
  if ! ln "$layout_lock" "$layout_reclaimer" 2>/dev/null; then
    return 1
  fi
  temporary_layout_reclaimer=$layout_reclaimer
  if ! same_regular_file "$layout_lock" "$layout_reclaimer" || ! layout_lock_owner_record "$layout_lock" || [ "$layout_lock_owner_pid" != "$owner_pid" ] || [ "$layout_lock_owner_token" != "$owner_token" ]; then
    rm -f "$layout_reclaimer"
    temporary_layout_reclaimer=''
    return 1
  fi
  if ! rm -f "$layout_lock"; then
    rm -f "$layout_reclaimer"
    temporary_layout_reclaimer=''
    return 1
  fi
  rm -f "$layout_reclaimer"
  temporary_layout_reclaimer=''
  return 0
}

resolve_notes_root() {
  create=${1:-no}
  requested_root=${SB_NOTES_ROOT:-"$HOME/.notes"}
  [ -n "$requested_root" ] || die 'refusing empty SB_NOTES_ROOT'
  require_single_line 'notes root' "$requested_root"
  case "$requested_root" in
    /*) ;;
    *) die "notes root must be absolute: $requested_root" ;;
  esac
  case "/$requested_root/" in
    */../*) die "refusing escaping notes root: $requested_root" ;;
  esac
  case "$requested_root" in
    /|"$HOME"|"$HOME"/) die "refusing unsafe notes root: $requested_root" ;;
  esac
  [ -d "$HOME" ] || die "cannot resolve home directory: $HOME"
  home_path=$(canonical_dir "$HOME") || die "cannot resolve home directory: $HOME"

  if [ "$create" = yes ] && [ ! -e "$requested_root" ]; then
    mkdir -p "$requested_root" || die "cannot create notes root: $requested_root"
    chmod 700 "$requested_root" || die "cannot secure notes root: $requested_root"
  fi
  [ -d "$requested_root" ] || die "notes root is unavailable: $requested_root"
  [ ! -L "$requested_root" ] || die "refusing symlinked notes root: $requested_root"
  notes_root=$(canonical_dir "$requested_root") || die "cannot resolve notes root: $requested_root"
  case "$notes_root" in
    /|"$home_path") die "refusing unsafe notes root: $notes_root" ;;
  esac
  printf '%s\n' "$notes_root"
}

begin_notes_operation() {
  create_root=${1:-no}
  notes_root=$(resolve_notes_root "$create_root")
  acquire_layout_lock "$notes_root"
  recover_incomplete_layout_transactions
}

require_absolute_task_path() {
  case "$1" in
    /*) ;;
    *) die "task path must be absolute: $1" ;;
  esac
}

assert_path_inside_root() {
  notes_root=$1
  task_path=$2
  case "$task_path/" in
    "$notes_root/"*) ;;
    *) die "task path is outside notes root: $task_path" ;;
  esac
}

assert_safe_tree() {
  tree_root=$1
  [ -d "$tree_root" ] && [ ! -L "$tree_root" ] || die "notes repository directory is missing or unsafe: $tree_root"
  unsafe_path=$(find "$tree_root" -type l -print -quit)
  [ -z "$unsafe_path" ] || die "refusing symlinked notes entry: $unsafe_path"
}

validate_metadata() {
  notes_root=$1
  requested_task_path=$2
  require_absolute_task_path "$requested_task_path"
  [ -d "$requested_task_path" ] || die "task path is unavailable: $requested_task_path"
  [ ! -L "$requested_task_path" ] || die "refusing symlinked task path: $requested_task_path"
  task_path=$(canonical_dir "$requested_task_path") || die "cannot resolve task path: $requested_task_path"
  assert_path_inside_root "$notes_root" "$task_path"
  metadata_file="$task_path/metadata.env"
  [ -f "$metadata_file" ] && [ ! -L "$metadata_file" ] || die "task metadata is missing or unsafe: $metadata_file"
  for field in schema repo_key branch_key task_key task_id repo_raw_identity repo_canonical_identity worktree_provenance; do
    grep -q "^$field=" "$metadata_file" || die "task metadata is malformed: missing $field"
  done
  printf '%s\n' "$task_path"
}

require_state_section() {
  section=$1
  state_source=$2
  grep -qx "## $section" "$state_source" || die "state is malformed: missing section $section"
}

validate_state_frontmatter() {
  state_source=$1
  awk '
    BEGIN {
      split("schema task_id task_key title status repo_raw_identity repo_canonical_identity repo_key branch_raw branch_key worktree_provenance areas risk contract_version last_verified_sha created_at updated_at", fields, " ")
      for (field_index in fields) required[fields[field_index]] = 1
    }
    NR == 1 {
      if ($0 != "---") invalid = 1
      in_frontmatter = 1
      next
    }
    in_frontmatter {
      if ($0 == "---") {
        in_frontmatter = 0
        closed = 1
        next
      }
      if ($0 !~ /^[a-z_]+: /) {
        invalid = 1
        next
      }
      field = $0
      sub(/:.*/, "", field)
      if (!(field in required) || ++count[field] != 1) invalid = 1
      next
    }
    {
      field = $0
      sub(/:.*/, "", field)
      if (field in required && $0 ~ /^[a-z_]+:/) invalid = 1
    }
    END {
      if (!closed) invalid = 1
      for (field in required) if (count[field] != 1) invalid = 1
      exit invalid ? 1 : 0
    }
  ' "$state_source" || die "state frontmatter is malformed, duplicated, or conflicts with body content: $state_source"
}

state_frontmatter_value() {
  state_source=$1
  wanted_field=$2
  awk -v wanted="$wanted_field" '
    NR == 1 { in_frontmatter = 1; next }
    in_frontmatter && $0 == "---" { exit }
    in_frontmatter && index($0, wanted ": ") == 1 {
      print substr($0, length(wanted) + 3)
      exit
    }
  ' "$state_source"
}

require_quoted_state_field() {
  field=$1
  state_source=$2
  value=$(state_frontmatter_value "$state_source" "$field")
  case "$value" in
    \"*\") ;;
    *) die "state is malformed: $field must be a quoted scalar" ;;
  esac
}

validate_state_file() {
  state_source=$1
  state_metadata=${2:-}
  [ -f "$state_source" ] && [ ! -L "$state_source" ] || die "state is missing or unsafe: $state_source"
  state_size=$(file_size "$state_source")
  [ "$state_size" -le "$STATE_MAX_BYTES" ] || die "state exceeds ${STATE_MAX_BYTES}-byte limit: $state_source"
  validate_state_frontmatter "$state_source"
  [ "$(state_frontmatter_value "$state_source" schema)" = 'sb-task-notes/v1' ] || die "state has unsupported schema: $state_source"
  [ "$(state_frontmatter_value "$state_source" contract_version)" = '1' ] || die "state has unsupported contract version: $state_source"
  for field in task_id task_key title status repo_raw_identity repo_canonical_identity repo_key branch_raw branch_key worktree_provenance areas risk last_verified_sha created_at updated_at; do
    require_quoted_state_field "$field" "$state_source"
  done
  for section in 'Outcome Contract' 'Confirmed Facts' 'In Progress' 'Remaining' 'Decisions' 'Risks and Uncertainty' 'Resume'; do
    require_state_section "$section" "$state_source"
  done

  if [ -n "$state_metadata" ]; then
    for field in task_id task_key repo_raw_identity repo_canonical_identity repo_key branch_raw branch_key worktree_provenance; do
      expected=$(metadata_value "$field" "$state_metadata")
      actual=$(state_frontmatter_value "$state_source" "$field")
      [ "$actual" = "\"$(yaml_quote "$expected")\"" ] || die "state does not match task metadata: $field"
    done
  fi
}

validate_task_store() {
  notes_root=$1
  requested_task_path=$2
  task_path=$(validate_metadata "$notes_root" "$requested_task_path")
  validate_state_file "$task_path/state.md" "$task_path/metadata.env"
  printf '%s\n' "$task_path"
}

print_paths() {
  task_path=$1
  printf 'task_path=%s\n' "$task_path"
  printf 'state_path=%s\n' "$task_path/state.md"
}

git_identity() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die 'init requires a Git worktree'
  worktree_path=$(git rev-parse --show-toplevel) || die 'cannot resolve Git worktree'
  worktree_path=$(canonical_dir "$worktree_path") || die 'cannot resolve Git worktree path'
  require_single_line 'worktree path' "$worktree_path"
  origin=$(git -C "$worktree_path" remote get-url origin 2>/dev/null || true)

  if [ -n "$origin" ]; then
    require_short_text 'origin identity' "$origin"
    origin_display=$(printf '%s' "$origin" | sed -E 's#^([^:/]+://)[^/@]*@#\1#; s#^[^@]+@([^:]+:)#\1#')
    origin_path=$(printf '%s' "$origin_display" | sed -E 's#^[^:]+://[^/]+/##; s#^[^@]+@[^:]+:##; s#^[^/:]+:##; s#^/##; s#/$##; s#\.git$##')
    owner_repo=$(printf '%s' "$origin_path" | awk -F/ '{ if (NF >= 2) print $(NF - 1) "/" $NF; else print $NF }')
    [ -n "$owner_repo" ] || die "cannot normalize origin identity: $origin_display"
    repo_key="$(slug "$owner_repo")"
    repo_raw_identity="origin:$origin_display"
    repo_canonical_identity="origin:$owner_repo"
  else
    if common_dir=$(git -C "$worktree_path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
      :
    else
      common_dir=$(git -C "$worktree_path" rev-parse --git-common-dir) || die 'cannot resolve Git common directory'
      case "$common_dir" in
        /*) ;;
        *) common_dir="$worktree_path/$common_dir" ;;
      esac
    fi
    common_dir=$(canonical_dir "$common_dir") || die "cannot canonicalize Git common directory: $common_dir"
    require_single_line 'Git common directory' "$common_dir"
    common_base=$(basename "$common_dir")
    if [ "$common_base" = '.git' ]; then
      repo_name=$(basename "$(dirname "$common_dir")")
    else
      repo_name=${common_base%.git}
    fi
    repo_key="$(slug "$repo_name")"
    repo_raw_identity="common-dir:$common_dir"
    repo_canonical_identity="common-dir:$common_dir"
  fi

  if branch_raw=$(git -C "$worktree_path" symbolic-ref --quiet --short HEAD 2>/dev/null); then
    branch_key="$(slug "$branch_raw")-$(short_hash "$branch_raw")"
  else
    detached_sha=$(git -C "$worktree_path" rev-parse --short=12 HEAD 2>/dev/null || true)
    [ -n "$detached_sha" ] || detached_sha='unborn'
    branch_raw="detached:$detached_sha"
    branch_key="detached-$detached_sha"
  fi
  last_verified_sha=$(git -C "$worktree_path" rev-parse HEAD 2>/dev/null || true)
}

write_metadata() {
  directory=$1
  file="$directory/metadata.env"
  temporary_file=$(mktemp "$directory/.metadata.env.XXXXXX") || die "cannot create metadata temporary file in $directory"
  {
    printf 'schema=sb-task-notes-metadata/v1\n'
    printf 'repo_key=%s\n' "$repo_key"
    printf 'branch_key=%s\n' "$branch_key"
    printf 'task_key=%s\n' "$task_key"
    printf 'task_id=%s\n' "$task_id"
    printf 'repo_raw_identity=%s\n' "$repo_raw_identity"
    printf 'repo_canonical_identity=%s\n' "$repo_canonical_identity"
    printf 'branch_raw=%s\n' "$branch_raw"
    printf 'worktree_provenance=%s\n' "$worktree_path"
    printf 'created_date=%s\n' "$created_date"
    printf 'created_at=%s\n' "$created_at"
  } > "$temporary_file"
  chmod 600 "$temporary_file"
  mv "$temporary_file" "$file"
}

write_initial_state() {
  directory=$1
  state_destination="$directory/state.md"
  temporary_file=$(mktemp "$directory/.state.md.XXXXXX") || die "cannot create state temporary file in $directory"
  {
    printf '%s\n' '---'
    printf '%s\n' 'schema: sb-task-notes/v1'
    printf 'task_id: "%s"\n' "$(yaml_quote "$task_id")"
    printf 'task_key: "%s"\n' "$(yaml_quote "$task_key")"
    printf 'title: "%s"\n' "$(yaml_quote "$title")"
    printf 'status: "%s"\n' "$(yaml_quote "$status")"
    printf 'repo_raw_identity: "%s"\n' "$(yaml_quote "$repo_raw_identity")"
    printf 'repo_canonical_identity: "%s"\n' "$(yaml_quote "$repo_canonical_identity")"
    printf 'repo_key: "%s"\n' "$(yaml_quote "$repo_key")"
    printf 'branch_raw: "%s"\n' "$(yaml_quote "$branch_raw")"
    printf 'branch_key: "%s"\n' "$(yaml_quote "$branch_key")"
    printf 'worktree_provenance: "%s"\n' "$(yaml_quote "$worktree_path")"
    printf 'areas: "%s"\n' "$(yaml_quote "$areas")"
    printf 'risk: "%s"\n' "$(yaml_quote "$risk")"
    printf '%s\n' 'contract_version: 1'
    printf 'last_verified_sha: "%s"\n' "$(yaml_quote "$last_verified_sha")"
    printf 'created_at: "%s"\n' "$(yaml_quote "$created_at")"
    printf 'updated_at: "%s"\n' "$(yaml_quote "$created_at")"
    printf '%s\n\n' '---'
    printf '%s\n\n' '# Task State'
    printf '%s\n\n' '## Outcome Contract'
    printf '%s\n\n' '## Confirmed Facts'
    printf '%s\n\n' '## In Progress'
    printf '%s\n\n' '## Remaining'
    printf '%s\n\n' '## Decisions'
    printf '%s\n\n' '## Risks and Uncertainty'
    printf '%s\n' '## Resume'
    printf '%s\n' '- Last checkpoint: none'
    printf '%s\n' '- Exact next action: establish the first implementation step'
    printf '%s\n' '- First verifier: not assigned'
    printf '%s\n' '- Human decision: none'
    printf '%s\n' "- Worktree provenance: $worktree_path"
    printf '%s\n' '- Relevant checkpoints: none'
  } > "$temporary_file"
  chmod 600 "$temporary_file"
  validate_state_file "$temporary_file" "$directory/metadata.env"
  mv "$temporary_file" "$state_destination"
}

verify_existing_task_identity() {
  existing_task_path=$1
  existing_metadata="$existing_task_path/metadata.env"
  [ "$(metadata_value repo_key "$existing_metadata")" = "$repo_key" ] || die "existing task has a different repository identity: $existing_task_path"
  [ "$(metadata_value branch_key "$existing_metadata")" = "$branch_key" ] || die "existing task has a different branch identity: $existing_task_path"
  [ "$(metadata_value task_key "$existing_metadata")" = "$task_key" ] || die "existing task has a different task key: $existing_task_path"
  [ "$(metadata_value task_id "$existing_metadata")" = "$task_id" ] || die "existing task has a different task identity: $existing_task_path"
}

validate_repository_identity() {
  repository_directory=$1
  expected_repo_key=$2
  expected_canonical_identity=$3
  assert_safe_tree "$repository_directory"

  repository_metadata_found=no
  while IFS= read -r existing_metadata; do
    [ -n "$existing_metadata" ] || continue
    repository_metadata_found=yes
    [ "$(metadata_value repo_key "$existing_metadata")" = "$expected_repo_key" ] || die "clean repository key collision: $repository_directory has a different repository key"
    [ "$(metadata_value repo_canonical_identity "$existing_metadata")" = "$expected_canonical_identity" ] || die "clean repository key collision: $repository_directory has a different canonical repository identity"
  done <<EOF
$(metadata_files "$repository_directory")
EOF

  if [ "$repository_metadata_found" = no ]; then
    return
  fi
}

find_legacy_repository_for_identity() {
  wanted_identity=$1
  wanted_clean_key=$2
  for repository_directory in "$notes_root"/*; do
    [ -d "$repository_directory" ] || continue
    [ ! -L "$repository_directory" ] || die "refusing symlinked notes repository directory: $repository_directory"
    first_metadata=$(metadata_files "$repository_directory" | sed -n '1p')
    [ -n "$first_metadata" ] || continue
    candidate_key=$(metadata_value repo_key "$first_metadata")
    candidate_identity=$(metadata_value repo_canonical_identity "$first_metadata")
    [ "$candidate_identity" = "$wanted_identity" ] || continue
    [ "$candidate_key" != "$wanted_clean_key" ] || continue
    is_old_repo_key "$candidate_key" || continue
    printf '%s\n' "$repository_directory"
    return 0
  done
  return 0
}

find_existing_explicit_task() {
  repository_directory=$1
  matching_task_path=''
  matching_task_count=0
  matching_task_paths=''
  for existing_date_directory in "$repository_directory"/*; do
    [ -d "$existing_date_directory" ] || continue
    candidate_path="$existing_date_directory/$branch_key/$task_key"
    [ -e "$candidate_path" ] || continue
    validated_candidate=$(validate_task_store "$notes_root" "$candidate_path")
    verify_existing_task_identity "$validated_candidate"
    matching_task_count=$((matching_task_count + 1))
    matching_task_path=$validated_candidate
    matching_task_paths="${matching_task_paths}${matching_task_paths:+
}$validated_candidate"
  done
  if [ "$matching_task_count" -gt 1 ]; then
    printf '%s\n%s\n' 'sb-notes: explicit task is ambiguous; candidate paths:' "$matching_task_paths" >&2
    exit 1
  fi
  if [ "$matching_task_count" -eq 1 ]; then
    printf '%s\n' "$matching_task_path"
  fi
}

init_task() {
  task_id=''
  explicit_task_id=no
  title=''
  status='initialized'
  areas='unspecified'
  risk='unspecified'

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --task-id) need_value "$@"; task_id=$2; explicit_task_id=yes; shift 2 ;;
      --title) need_value "$@"; title=$2; shift 2 ;;
      --status) need_value "$@"; status=$2; shift 2 ;;
      --areas) need_value "$@"; areas=$2; shift 2 ;;
      --risk) need_value "$@"; risk=$2; shift 2 ;;
      *) usage ;;
    esac
  done

  begin_notes_operation yes
  require_short_text status "$status"
  require_short_text areas "$areas"
  require_short_text risk "$risk"
  git_identity
  created_date=$(date '+%y%m%d')
  created_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

  if [ -n "$task_id" ]; then
    require_short_text 'task ID' "$task_id"
    task_key="$(slug "$task_id")-$(short_hash "$task_id")"
  else
    [ "$explicit_task_id" = no ] || die 'task ID must not be empty'
    task_id="task-$(date '+%Y%m%dT%H%M%S')"
    task_key="$task_id"
  fi
  if [ -z "$title" ]; then
    title=$task_id
  fi
  require_short_text title "$title"

  legacy_repository=$(find_legacy_repository_for_identity "$repo_canonical_identity" "$repo_key")
  [ -z "$legacy_repository" ] || die "legacy repository layout must be migrated before init creates $repo_key: $legacy_repository"

  repo_dir="$notes_root/$repo_key"
  if [ -e "$repo_dir" ]; then
    validate_repository_identity "$repo_dir" "$repo_key" "$repo_canonical_identity"
  fi
  ensure_private_directory "$repo_dir"
  acquire_lock "$repo_dir/.locks/$branch_key.lock"
  validate_repository_identity "$repo_dir" "$repo_key" "$repo_canonical_identity"

  if [ "$explicit_task_id" = yes ]; then
    existing_task_path=$(find_existing_explicit_task "$repo_dir")
    if [ -n "$existing_task_path" ]; then
      release_lock
      release_layout_lock
      print_paths "$existing_task_path"
      return
    fi
  fi

  date_dir="$repo_dir/$created_date"
  branch_dir="$date_dir/$branch_key"
  ensure_private_directory "$date_dir"
  ensure_private_directory "$branch_dir"
  task_path="$branch_dir/$task_key"

  if [ "$explicit_task_id" = no ]; then
    candidate=1
    while [ -e "$task_path" ]; do
      task_id="task-$(date '+%Y%m%dT%H%M%S')-$candidate"
      task_key=$task_id
      task_path="$branch_dir/$task_key"
      candidate=$((candidate + 1))
    done
  fi

  creating_task=$task_path
  mkdir "$task_path" || die "cannot reserve task store: $task_path"
  chmod 700 "$task_path" || die "cannot secure task store: $task_path"
  write_metadata "$task_path"
  write_initial_state "$task_path"
  creating_task=''
  release_lock
  release_layout_lock
  print_paths "$task_path"
}

resolve_task() {
  task_path=''
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --task-path) need_value "$@"; task_path=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  [ -n "$task_path" ] || usage
  begin_notes_operation no
  task_path=$(validate_task_store "$notes_root" "$task_path")
  release_layout_lock
  print_paths "$task_path"
}

read_state() {
  task_path=''
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --task-path) need_value "$@"; task_path=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  [ -n "$task_path" ] || usage
  begin_notes_operation no
  task_path=$(validate_task_store "$notes_root" "$task_path")
  cat "$task_path/state.md"
  release_layout_lock
}

replace_state() {
  task_path=''
  expected_hash=''
  replacement_file=''
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --task-path) need_value "$@"; task_path=$2; shift 2 ;;
      --expected-hash) need_value "$@"; expected_hash=$2; shift 2 ;;
      --file) need_value "$@"; replacement_file=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  [ -n "$task_path" ] && [ -n "$expected_hash" ] && [ -n "$replacement_file" ] || usage
  printf '%s' "$expected_hash" | grep -Eq '^[0-9a-fA-F]{64}$' || die 'expected state hash must be a SHA-256 hex digest'
  begin_notes_operation no
  task_path=$(validate_metadata "$notes_root" "$task_path")
  [ -f "$replacement_file" ] && [ ! -L "$replacement_file" ] || die "replacement state is missing or unsafe: $replacement_file"
  temporary_state=$(mktemp "$task_path/.state.md.XXXXXX") || die "cannot create state temporary file in $task_path"
  cp "$replacement_file" "$temporary_state" || die "cannot stage replacement state: $replacement_file"
  chmod 600 "$temporary_state"
  validate_state_file "$temporary_state" "$task_path/metadata.env"
  acquire_lock "$task_path/.locks/state.lock"
  validate_state_file "$task_path/state.md" "$task_path/metadata.env"
  current_hash=$(hash_file "$task_path/state.md")
  [ "$current_hash" = "$expected_hash" ] || die "state changed since the supplied baseline: $task_path/state.md"
  mv "$temporary_state" "$task_path/state.md" || die "cannot replace state: $task_path/state.md"
  temporary_state=''
  release_lock
  release_layout_lock
  printf 'state_path=%s\n' "$task_path/state.md"
}

validate_checkpoint_body() {
  body_file=$1
  [ -f "$body_file" ] && [ ! -L "$body_file" ] || die "checkpoint body is missing or unsafe: $body_file"
  body_size=$(file_size "$body_file")
  [ "$body_size" -le "$CHECKPOINT_MAX_BYTES" ] || die "checkpoint body exceeds ${CHECKPOINT_MAX_BYTES}-byte limit: $body_file"
  for section in Observation Actions 'Decision Delta' 'Attempts and Failures' Verification Handoff; do
    grep -qx "## $section" "$body_file" || die "checkpoint body is malformed: missing section $section"
  done
}

checkpoint() {
  task_path=''
  kind=''
  actor=''
  input_sha=''
  output_sha=''
  body_file=''
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --task-path) need_value "$@"; task_path=$2; shift 2 ;;
      --kind) need_value "$@"; kind=$2; shift 2 ;;
      --actor) need_value "$@"; actor=$2; shift 2 ;;
      --input-sha) need_value "$@"; input_sha=$2; shift 2 ;;
      --output-sha) need_value "$@"; output_sha=$2; shift 2 ;;
      --file) need_value "$@"; body_file=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  [ -n "$task_path" ] && [ -n "$kind" ] && [ -n "$actor" ] && [ -n "$input_sha" ] && [ -n "$output_sha" ] && [ -n "$body_file" ] || usage
  case "$kind" in implementation|fix|verification|review|decision|handoff) ;; *) die "unsupported checkpoint kind: $kind" ;; esac
  require_short_text actor "$actor"
  require_short_text input_sha "$input_sha"
  require_short_text output_sha "$output_sha"
  begin_notes_operation no
  task_path=$(validate_task_store "$notes_root" "$task_path")
  validate_checkpoint_body "$body_file"
  checkpoint_dir="$task_path/checkpoints"
  ensure_private_directory "$checkpoint_dir"
  checkpoint_time=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
  temporary_checkpoint=$(mktemp "$checkpoint_dir/.checkpoint-$(date -u '+%Y%m%dT%H%M%SZ')-XXXXXX") || die "cannot create checkpoint in $checkpoint_dir"
  checkpoint_file="$checkpoint_dir/$(basename "$temporary_checkpoint" | sed 's/^\.//').md"
  {
    printf '%s\n' '---'
    printf '%s\n' 'schema: sb-task-checkpoint/v1'
    printf 'kind: "%s"\n' "$(yaml_quote "$kind")"
    printf 'actor: "%s"\n' "$(yaml_quote "$actor")"
    printf 'time: "%s"\n' "$(yaml_quote "$checkpoint_time")"
    printf 'input_sha: "%s"\n' "$(yaml_quote "$input_sha")"
    printf 'output_sha: "%s"\n' "$(yaml_quote "$output_sha")"
    printf 'worktree_provenance: "%s"\n' "$(yaml_quote "$(metadata_value worktree_provenance "$task_path/metadata.env")")"
    printf '%s\n\n' '---'
    cat "$body_file"
  } > "$temporary_checkpoint"
  checkpoint_size=$(file_size "$temporary_checkpoint")
  if [ "$checkpoint_size" -gt "$CHECKPOINT_MAX_BYTES" ]; then
    rm -f "$temporary_checkpoint"
    temporary_checkpoint=''
    die "checkpoint exceeds ${CHECKPOINT_MAX_BYTES}-byte limit"
  fi
  chmod 600 "$temporary_checkpoint"
  if ! ln "$temporary_checkpoint" "$checkpoint_file"; then
    rm -f "$temporary_checkpoint"
    temporary_checkpoint=''
    die "checkpoint destination already exists or cannot be published: $checkpoint_file"
  fi
  rm -f "$temporary_checkpoint"
  temporary_checkpoint=''
  release_layout_lock
  printf 'checkpoint_path=%s\n' "$checkpoint_file"
}

clean_repo_key_from_identity() {
  canonical_identity=$1
  case "$canonical_identity" in
    origin:*)
      slug "${canonical_identity#origin:}"
      ;;
    common-dir:*)
      common_dir=${canonical_identity#common-dir:}
      common_base=$(basename "$common_dir")
      if [ "$common_base" = '.git' ]; then
        repo_name=$(basename "$(dirname "$common_dir")")
      else
        repo_name=${common_base%.git}
      fi
      slug "$repo_name"
      ;;
    *) die "unsupported repository identity for layout migration: $canonical_identity" ;;
  esac
}

is_old_repo_key() {
  printf '%s\n' "$1" | grep -Eq '^[a-z0-9][a-z0-9-]*-[0-9a-f]{12}$'
}

validate_checkpoint_directory() {
  checkpoint_directory=$1
  require_markdown=${2:-yes}
  [ ! -e "$checkpoint_directory" ] && return
  [ -d "$checkpoint_directory" ] && [ ! -L "$checkpoint_directory" ] || die "checkpoint directory is unsafe: $checkpoint_directory"
  interrupted_checkpoint=$(find "$checkpoint_directory" -maxdepth 1 -type f -name '.checkpoint-*' -print -quit)
  [ -z "$interrupted_checkpoint" ] || die "checkpoint directory contains interrupted temporary checkpoint: $interrupted_checkpoint"
  while IFS= read -r checkpoint_file; do
    [ -n "$checkpoint_file" ] || continue
    checkpoint_size=$(file_size "$checkpoint_file")
    [ "$checkpoint_size" -le "$CHECKPOINT_MAX_BYTES" ] || die "checkpoint exceeds ${CHECKPOINT_MAX_BYTES}-byte limit: $checkpoint_file"
    if [ "$require_markdown" = yes ]; then
      case "$checkpoint_file" in *.md) ;; *) die "checkpoint is missing .md extension: $checkpoint_file" ;; esac
    fi
  done <<EOF
$(find "$checkpoint_directory" -maxdepth 1 -type f -print | LC_ALL=C sort)
EOF
}

validate_repository_store() {
  repository_directory=$1
  expected_repo_key=$2
  expected_canonical_identity=$3
  require_markdown=${4:-yes}
  assert_safe_tree "$repository_directory"
  repository_metadata_count=0
  while IFS= read -r store_metadata; do
    [ -n "$store_metadata" ] || continue
    store_path=$(dirname "$store_metadata")
    validate_task_store "$notes_root" "$store_path" >/dev/null
    [ "$(metadata_value repo_key "$store_metadata")" = "$expected_repo_key" ] || die "repository store has an inconsistent repository key: $store_path"
    [ "$(metadata_value repo_canonical_identity "$store_metadata")" = "$expected_canonical_identity" ] || die "repository store has an inconsistent canonical repository identity: $store_path"
    validate_checkpoint_directory "$store_path/checkpoints" "$require_markdown"
    repository_metadata_count=$((repository_metadata_count + 1))
  done <<EOF
$(metadata_files "$repository_directory")
EOF
  [ "$repository_metadata_count" -gt 0 ] || die "repository directory has no task stores: $repository_directory"
}

repository_canonical_identity() {
  repository_directory=$1
  first_metadata=$(metadata_files "$repository_directory" | sed -n '1p')
  [ -n "$first_metadata" ] || die "repository directory has no task stores: $repository_directory"
  metadata_value repo_canonical_identity "$first_metadata"
}

rewrite_file_literal() {
  source_file=$1
  old_text=$2
  new_text=$3
  grep -Fq -- "$old_text" "$source_file" || return 0
  source_mode=$(file_mode "$source_file")
  source_directory=$(dirname "$source_file")
  rewritten_file=$(mktemp "$source_directory/.layout-rewrite.XXXXXX") || die "cannot stage layout rewrite: $source_file"
  awk -v old_text="$old_text" -v new_text="$new_text" '
    {
      remaining = $0
      while ((offset = index(remaining, old_text)) != 0) {
        printf "%s%s", substr(remaining, 1, offset - 1), new_text
        remaining = substr(remaining, offset + length(old_text))
      }
      print remaining
    }
  ' "$source_file" > "$rewritten_file" || die "cannot rewrite layout reference: $source_file"
  chmod "$source_mode" "$rewritten_file" || die "cannot restore mode after layout rewrite: $source_file"
  touch -r "$source_file" "$rewritten_file" || die "cannot restore timestamp after layout rewrite: $source_file"
  mv "$rewritten_file" "$source_file" || die "cannot publish layout rewrite: $source_file"
}

rewrite_repository_markdown() {
  repository_directory=$1
  old_text=$2
  new_text=$3
  while IFS= read -r markdown_file; do
    [ -n "$markdown_file" ] || continue
    rewrite_file_literal "$markdown_file" "$old_text" "$new_text"
  done <<EOF
$(find "$repository_directory" \( -name state.md -o -path '*/checkpoints/*' \) -type f -print | LC_ALL=C sort)
EOF
}

rewrite_repository_metadata_key() {
  repository_directory=$1
  old_repo_key=$2
  new_repo_key=$3
  while IFS= read -r store_metadata; do
    [ -n "$store_metadata" ] || continue
    rewrite_file_literal "$store_metadata" "repo_key=$old_repo_key" "repo_key=$new_repo_key"
    rewrite_file_literal "$(dirname "$store_metadata")/state.md" "repo_key: \"$old_repo_key\"" "repo_key: \"$new_repo_key\""
  done <<EOF
$(metadata_files "$repository_directory")
EOF
}

rewrite_checkpoint_references() {
  destination_repository=$1
  source_repository=$2
  final_repository=$3
  while IFS= read -r source_checkpoint; do
    [ -n "$source_checkpoint" ] || continue
    relative_checkpoint=${source_checkpoint#"$source_repository"/}
    case "$relative_checkpoint" in *.md) final_checkpoint="$final_repository/$relative_checkpoint" ;; *) final_checkpoint="$final_repository/$relative_checkpoint.md" ;; esac
    rewrite_repository_markdown "$destination_repository" "$source_checkpoint" "$final_checkpoint"
  done <<EOF
$(find "$source_repository" -path '*/checkpoints/*' -type f -print | LC_ALL=C sort)
EOF
}

rename_extensionless_checkpoints() {
  repository_directory=$1
  while IFS= read -r checkpoint_file; do
    [ -n "$checkpoint_file" ] || continue
    case "$checkpoint_file" in
      *.md) ;;
      *)
        markdown_checkpoint="$checkpoint_file.md"
        [ ! -e "$markdown_checkpoint" ] || die "checkpoint destination already exists: $markdown_checkpoint"
        mv "$checkpoint_file" "$markdown_checkpoint" || die "cannot rename checkpoint: $checkpoint_file"
        ;;
    esac
  done <<EOF
$(find "$repository_directory" -path '*/checkpoints/*' -type f -print | LC_ALL=C sort)
EOF
}

transaction_value() {
  metadata_value "$1" "$2"
}

transaction_mapping_files() {
  find "$1/mappings" -type f -name '*.env' -print 2>/dev/null | LC_ALL=C sort
}

write_transaction_manifest() {
  transaction_directory=$1
  transaction_phase=$2
  transaction_backup=$3
  manifest_temporary=$(mktemp "$transaction_directory/.manifest.env.XXXXXX") || die "cannot stage layout transaction manifest: $transaction_directory"
  {
    printf '%s\n' 'schema=sb-notes-layout-transaction/v1'
    printf 'phase=%s\n' "$transaction_phase"
    printf 'final_backup=%s\n' "$transaction_backup"
  } > "$manifest_temporary"
  chmod 600 "$manifest_temporary"
  mv "$manifest_temporary" "$transaction_directory/manifest.env" || die "cannot publish layout transaction manifest: $transaction_directory"
}

write_transaction_mapping() {
  transaction_directory=$1
  mapping_number=$2
  mapping_old=$3
  mapping_clean=$4
  mapping_stage=$5
  mapping_backup=$6
  mapping_identity=$7
  mapping_old_key=$8
  mapping_clean_key=$9
  mapping_token="$notes_root/.sb-notes-layout-reservation-$(basename "$transaction_directory")-$mapping_clean_key"
  mapping_temporary=$(mktemp "$transaction_directory/mappings/.$mapping_number.XXXXXX") || die "cannot stage layout transaction mapping: $transaction_directory"
  {
    printf 'old_root=%s\n' "$mapping_old"
    printf 'clean_root=%s\n' "$mapping_clean"
    printf 'stage_root=%s\n' "$mapping_stage"
    printf 'backup_root=%s\n' "$mapping_backup"
    printf 'canonical_identity=%s\n' "$mapping_identity"
    printf 'old_repo_key=%s\n' "$mapping_old_key"
    printf 'clean_repo_key=%s\n' "$mapping_clean_key"
    printf 'reservation_token=%s\n' "$mapping_token"
    printf '%s\n' 'published=no'
  } > "$mapping_temporary"
  chmod 600 "$mapping_temporary"
  mv "$mapping_temporary" "$transaction_directory/mappings/$mapping_number.env" || die "cannot publish layout transaction mapping: $transaction_directory"
}

reservation_token_is_safe() {
  reservation_token=$1
  case "$reservation_token" in
    "$notes_root"/.sb-notes-layout-reservation-*) ;;
    *) return 1 ;;
  esac
  require_single_line 'layout reservation token' "$reservation_token"
}

reservation_token_matches_transaction() {
  transaction_directory=$1
  mapping_file=$2
  reservation_token=$(transaction_value reservation_token "$mapping_file")
  clean_root=$(transaction_value clean_root "$mapping_file")
  reservation_token_is_safe "$reservation_token" || return 1
  [ -f "$reservation_token" ] && [ ! -L "$reservation_token" ] || return 1
  [ "$(sed -n '1p' "$reservation_token")" = "$transaction_directory" ] || return 1
  [ "$(sed -n '2p' "$reservation_token")" = "$clean_root" ] || return 1
  [ "$(wc -l < "$reservation_token" | tr -d ' ')" = 2 ]
}

reservation_marker_matches_transaction() {
  transaction_directory=$1
  mapping_file=$2
  clean_root=$(transaction_value clean_root "$mapping_file")
  reservation_marker="$clean_root/.sb-notes-layout-reservation"
  [ -f "$reservation_marker" ] && [ ! -L "$reservation_marker" ] || return 1
  [ "$(sed -n '1p' "$reservation_marker")" = "$transaction_directory" ] || return 1
  [ "$(sed -n '2p' "$reservation_marker")" = "$clean_root" ] || return 1
  [ "$(wc -l < "$reservation_marker" | tr -d ' ')" = 2 ]
}

create_reservation_token() {
  mapping_file=$1
  reservation_token=$(transaction_value reservation_token "$mapping_file")
  clean_root=$(transaction_value clean_root "$mapping_file")
  reservation_token_is_safe "$reservation_token" || die "unsafe layout reservation token: $reservation_token"
  [ ! -e "$reservation_token" ] || die "layout reservation token already exists: $reservation_token"
  temporary_reservation_token=$(mktemp "$notes_root/.sb-notes-layout-reservation.XXXXXX") || die "cannot stage layout reservation token: $notes_root"
  {
    printf '%s\n' "$migration_transaction"
    printf '%s\n' "$clean_root"
  } > "$temporary_reservation_token"
  chmod 600 "$temporary_reservation_token"
  if ! ln "$temporary_reservation_token" "$reservation_token"; then
    rm -f "$temporary_reservation_token"
    temporary_reservation_token=''
    die "cannot reserve layout migration destination: $clean_root"
  fi
  rm -f "$temporary_reservation_token"
  temporary_reservation_token=''
}

remove_reservation_token() {
  transaction_directory=$1
  mapping_file=$2
  reservation_token_matches_transaction "$transaction_directory" "$mapping_file" || return 1
  rm -f "$(transaction_value reservation_token "$mapping_file")"
}

remove_reservation_marker() {
  transaction_directory=$1
  mapping_file=$2
  clean_root=$(transaction_value clean_root "$mapping_file")
  reservation_marker_matches_transaction "$transaction_directory" "$mapping_file" || return 1
  rm -f "$clean_root/.sb-notes-layout-reservation"
}

destination_is_empty_directory() {
  destination_directory=$1
  [ -d "$destination_directory" ] && [ ! -L "$destination_directory" ] || return 1
  [ -z "$(find "$destination_directory" -mindepth 1 -print -quit 2>/dev/null)" ]
}

mark_transaction_mapping_published() {
  mapping_file=$1
  rewrite_file_literal "$mapping_file" 'published=no' 'published=yes'
  [ "$(transaction_value published "$mapping_file")" = yes ] || die "cannot record published layout destination: $mapping_file"
}

destination_is_owned_by_transaction() {
  transaction_directory=$1
  mapping_file=$2
  if [ "$(transaction_value published "$mapping_file")" = yes ]; then
    return 0
  fi
  reservation_token_matches_transaction "$transaction_directory" "$mapping_file" || return 1
  reservation_marker_matches_transaction "$transaction_directory" "$mapping_file"
}

repository_store_is_valid() {
  (validate_repository_store "$1" "$2" "$3" "${4:-yes}") >/dev/null 2>&1
}

remove_staged_locks() {
  find "$1" -depth -type d -name .locks -exec rm -rf {} \;
  staged_lock=$(find "$1" -type d -name .locks -print -quit)
  [ -z "$staged_lock" ] || die "staging retained a transient lock: $staged_lock"
}

transaction_has_entries() {
  [ -n "$(find "$1" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]
}

prepared_mapping_temporaries_are_safe() {
  transaction_directory=$1
  mapping_directory="$transaction_directory/mappings"
  [ -d "$mapping_directory" ] && [ ! -L "$mapping_directory" ] || return 1
  found_mapping_temporary=no
  while IFS= read -r mapping_temporary; do
    [ -n "$mapping_temporary" ] || continue
    found_mapping_temporary=yes
    [ -f "$mapping_temporary" ] && [ ! -L "$mapping_temporary" ] || return 1
    mapping_temporary_name=$(basename "$mapping_temporary")
    printf '%s' "$mapping_temporary_name" | grep -Eq '^\.[1-9][0-9]*\.[A-Za-z0-9]+$' || return 1
    temporary_old_root=$(transaction_value old_root "$mapping_temporary")
    temporary_clean_root=$(transaction_value clean_root "$mapping_temporary")
    temporary_old_key=$(transaction_value old_repo_key "$mapping_temporary")
    temporary_identity=$(transaction_value canonical_identity "$mapping_temporary")
    [ -n "$temporary_old_root" ] && [ -n "$temporary_clean_root" ] && [ -n "$temporary_old_key" ] && [ -n "$temporary_identity" ] || return 1
    [ ! -e "$temporary_clean_root" ] || return 1
    repository_store_is_valid "$temporary_old_root" "$temporary_old_key" "$temporary_identity" no || return 1
  done <<EOF
$(find "$mapping_directory" -mindepth 1 -maxdepth 1 -print | LC_ALL=C sort)
EOF
  [ "$found_mapping_temporary" = yes ]
}

prepared_transaction_can_be_discarded() {
  transaction_directory=$1
  transaction_name=$(basename "$transaction_directory")
  for reservation_token in "$notes_root"/.sb-notes-layout-reservation-"$transaction_name"-*; do
    [ ! -e "$reservation_token" ] || return 1
  done
  for transaction_part in staged backup failed; do
    [ ! -e "$transaction_directory/$transaction_part" ] || ! transaction_has_entries "$transaction_directory/$transaction_part" || return 1
  done
  if [ ! -e "$transaction_directory/mappings" ] || ! transaction_has_entries "$transaction_directory/mappings"; then
    return 0
  fi
  prepared_mapping_temporaries_are_safe "$transaction_directory"
}

discard_pre_manifest_transaction() {
  transaction_directory=$1
  [ -d "$transaction_directory" ] && [ ! -L "$transaction_directory" ] || return 1
  [ ! -e "$transaction_directory/manifest.env" ] || return 1
  transaction_name=$(basename "$transaction_directory")
  for reservation_token in "$notes_root"/.sb-notes-layout-reservation-"$transaction_name"-*; do
    [ ! -e "$reservation_token" ] || return 1
  done
  while IFS= read -r transaction_entry; do
    [ -n "$transaction_entry" ] || continue
    entry_name=$(basename "$transaction_entry")
    case "$entry_name" in
      staged|backup|failed|mappings) [ -d "$transaction_entry" ] && [ ! -L "$transaction_entry" ] || return 1 ;;
      .manifest.env.*) [ -f "$transaction_entry" ] && [ ! -L "$transaction_entry" ] || return 1 ;;
      *) return 1 ;;
    esac
  done <<EOF
$(find "$transaction_directory" -mindepth 1 -maxdepth 1 -print | LC_ALL=C sort)
EOF
  for transaction_part in backup failed; do
    [ ! -e "$transaction_directory/$transaction_part" ] || ! transaction_has_entries "$transaction_directory/$transaction_part" || return 1
  done
  if [ -e "$transaction_directory/mappings" ]; then
    while IFS= read -r mapping_temporary; do
      [ -n "$mapping_temporary" ] || continue
      [ -f "$mapping_temporary" ] && [ ! -L "$mapping_temporary" ] || return 1
      case "$(basename "$mapping_temporary")" in .*) ;; *) return 1 ;; esac
    done <<EOF
$(find "$transaction_directory/mappings" -mindepth 1 -print | LC_ALL=C sort)
EOF
  fi
  if [ -e "$transaction_directory/staged" ]; then
    staged_link=$(find "$transaction_directory/staged" -type l -print -quit)
    [ -z "$staged_link" ] || return 1
  fi
  rm -rf "$transaction_directory"
}

recover_layout_transaction() {
  transaction_directory=$1
  manifest_file="$transaction_directory/manifest.env"
  [ -d "$transaction_directory" ] && [ ! -L "$transaction_directory" ] || return 1
  if [ ! -e "$manifest_file" ]; then
    discard_pre_manifest_transaction "$transaction_directory"
    return
  fi
  [ -f "$manifest_file" ] && [ ! -L "$manifest_file" ] || return 1
  [ "$(transaction_value schema "$manifest_file")" = 'sb-notes-layout-transaction/v1' ] || return 1
  transaction_phase=$(transaction_value phase "$manifest_file")
  case "$transaction_phase" in
    prepared|staged|publishing|published|backing-up|backed-up|validated) ;;
    *) return 1 ;;
  esac
  final_backup=$(transaction_value final_backup "$manifest_file")
  mapping_files=$(transaction_mapping_files "$transaction_directory")
  [ -n "$final_backup" ] || return 1
  if [ -z "$mapping_files" ]; then
    [ "$transaction_phase" = prepared ] || return 1
    prepared_transaction_can_be_discarded "$transaction_directory" || return 1
    rm -rf "$transaction_directory"
    return 0
  fi

  any_old=no
  all_clean_valid=yes
  all_clean_owned=yes
  restoration_possible=yes
  while IFS= read -r mapping_file; do
    [ -n "$mapping_file" ] || continue
    old_root=$(transaction_value old_root "$mapping_file")
    clean_root=$(transaction_value clean_root "$mapping_file")
    backup_root=$(transaction_value backup_root "$mapping_file")
    canonical_identity=$(transaction_value canonical_identity "$mapping_file")
    old_repo_key=$(transaction_value old_repo_key "$mapping_file")
    clean_repo_key=$(transaction_value clean_repo_key "$mapping_file")
    reservation_token=$(transaction_value reservation_token "$mapping_file")
    [ -n "$old_root" ] && [ -n "$clean_root" ] && [ -n "$backup_root" ] && [ -n "$canonical_identity" ] && [ -n "$old_repo_key" ] && [ -n "$clean_repo_key" ] && [ -n "$reservation_token" ] || return 1
    reservation_token_is_safe "$reservation_token" || return 1
    [ -e "$old_root" ] && any_old=yes
    repository_store_is_valid "$clean_root" "$clean_repo_key" "$canonical_identity" yes || all_clean_valid=no
    if [ -e "$clean_root" ] && ! destination_is_owned_by_transaction "$transaction_directory" "$mapping_file"; then
      all_clean_owned=no
    fi
    if [ ! -e "$old_root" ] && [ ! -e "$backup_root" ]; then
      restoration_possible=no
    fi
  done <<EOF
$mapping_files
EOF

  if [ "$any_old" = no ] && [ "$all_clean_valid" = yes ] && [ "$all_clean_owned" = yes ]; then
    if [ -d "$transaction_directory/backup" ] && transaction_has_entries "$transaction_directory/backup"; then
      [ ! -e "$final_backup" ] || return 1
      mv "$transaction_directory/backup" "$final_backup" || return 1
    fi
    while IFS= read -r mapping_file; do
      [ -n "$mapping_file" ] || continue
      if reservation_token_matches_transaction "$transaction_directory" "$mapping_file"; then
        remove_reservation_marker "$transaction_directory" "$mapping_file" 2>/dev/null || true
        remove_reservation_token "$transaction_directory" "$mapping_file" || return 1
      fi
    done <<EOF
$mapping_files
EOF
    rm -rf "$transaction_directory"
    return 0
  fi

  [ "$restoration_possible" = yes ] || return 1
  while IFS= read -r mapping_file; do
    [ -n "$mapping_file" ] || continue
    old_root=$(transaction_value old_root "$mapping_file")
    backup_root=$(transaction_value backup_root "$mapping_file")
    if [ ! -e "$old_root" ]; then
      [ -e "$backup_root" ] || return 1
      mv "$backup_root" "$old_root" || return 1
    fi
  done <<EOF
$mapping_files
EOF

  while IFS= read -r mapping_file; do
    [ -n "$mapping_file" ] || continue
    repository_store_is_valid "$(transaction_value old_root "$mapping_file")" "$(transaction_value old_repo_key "$mapping_file")" "$(transaction_value canonical_identity "$mapping_file")" no || return 1
  done <<EOF
$mapping_files
EOF

  while IFS= read -r mapping_file; do
    [ -n "$mapping_file" ] || continue
    old_root=$(transaction_value old_root "$mapping_file")
    clean_root=$(transaction_value clean_root "$mapping_file")
    failed_root="$transaction_directory/failed/$(basename "$clean_root")"
    [ -e "$old_root" ] || return 1
    if [ -e "$clean_root" ]; then
      if destination_is_owned_by_transaction "$transaction_directory" "$mapping_file"; then
        [ ! -e "$failed_root" ] || return 1
        mv "$clean_root" "$failed_root" || return 1
      elif reservation_token_matches_transaction "$transaction_directory" "$mapping_file" && destination_is_empty_directory "$clean_root"; then
        rmdir "$clean_root" || return 1
      else
        return 1
      fi
    fi
    if reservation_token_matches_transaction "$transaction_directory" "$mapping_file"; then
      remove_reservation_token "$transaction_directory" "$mapping_file" || return 1
    fi
  done <<EOF
$mapping_files
EOF
  rm -rf "$transaction_directory"
  return 0
}

recover_current_migration() {
  [ -n "$migration_transaction" ] || return 0
  recover_layout_transaction "$migration_transaction" || printf '%s\n' "sb-notes: preserving incomplete layout transaction for recovery: $migration_transaction" >&2
  migration_transaction=''
  return 0
}

recover_incomplete_layout_transactions() {
  for transaction_directory in "$notes_root"/.sb-notes-layout-transaction.*; do
    [ -d "$transaction_directory" ] || continue
    recover_layout_transaction "$transaction_directory" || die "incomplete layout migration needs recovery before this operation: $transaction_directory"
  done
}

migrate_layout_preflight() {
  migration_old_roots=''
  migration_target_keys=''
  for repository_directory in "$notes_root"/*; do
    [ -d "$repository_directory" ] || continue
    [ ! -L "$repository_directory" ] || die "refusing symlinked notes repository directory: $repository_directory"
    repository_name=$(basename "$repository_directory")
    case "$repository_name" in .*) continue ;; esac
    first_metadata=$(metadata_files "$repository_directory" | sed -n '1p')
    [ -n "$first_metadata" ] || continue
    old_repo_key=$(metadata_value repo_key "$first_metadata")
    canonical_identity=$(metadata_value repo_canonical_identity "$first_metadata")
    clean_repo_key=$(clean_repo_key_from_identity "$canonical_identity")
    validate_repository_store "$repository_directory" "$old_repo_key" "$canonical_identity" no
    [ "$repository_name" = "$old_repo_key" ] || die "repository directory does not match metadata repo_key: $repository_directory"

    if [ "$old_repo_key" = "$clean_repo_key" ]; then
      validate_repository_identity "$repository_directory" "$clean_repo_key" "$canonical_identity"
      continue
    fi
    is_old_repo_key "$old_repo_key" || die "repository directory is neither the clean nor supported hashed layout: $repository_directory"
    [ ! -e "$notes_root/$clean_repo_key" ] || die "layout migration found both old and clean repository roots: $repository_directory and $notes_root/$clean_repo_key"
    case "|$migration_target_keys|" in
      *"|$clean_repo_key|"*) die "layout migration maps multiple repository identities to clean key: $clean_repo_key" ;;
    esac
    migration_target_keys="${migration_target_keys}${migration_target_keys:+|}$clean_repo_key"
    migration_old_roots="${migration_old_roots}${migration_old_roots:+
}$repository_directory"
  done
}

copy_repository_to_stage() {
  old_repository=$1
  staged_repository=$2
  mkdir "$staged_repository" || die "cannot stage repository layout migration: $old_repository"
  chmod 700 "$staged_repository"
  cp -pR "$old_repository"/. "$staged_repository" || die "cannot copy repository layout migration: $old_repository"
  remove_staged_locks "$staged_repository"
}

publish_staged_repository() {
  staged_repository=$1
  clean_repository=$2
  expected_repo_key=$3
  expected_identity=$4
  mapping_file=$5
  create_reservation_token "$mapping_file"
  [ ! -e "$clean_repository" ] || die "layout migration destination appeared during publication: $clean_repository"
  mkdir "$clean_repository" || die "cannot reserve layout migration destination: $clean_repository"
  chmod 700 "$clean_repository" || die "cannot secure layout migration destination: $clean_repository"
  reservation_file="$clean_repository/.sb-notes-layout-reservation"
  if ! ln "$(transaction_value reservation_token "$mapping_file")" "$reservation_file"; then
    die "cannot mark layout migration destination: $clean_repository"
  fi
  cp -pR "$staged_repository"/. "$clean_repository" || die "cannot publish layout migration destination: $clean_repository"
  remove_staged_locks "$clean_repository"
  repository_store_is_valid "$clean_repository" "$expected_repo_key" "$expected_identity" yes || die "published layout migration destination is invalid: $clean_repository"
  mark_transaction_mapping_published "$mapping_file"
  rm -f "$reservation_file"
  remove_reservation_token "$migration_transaction" "$mapping_file" || die "cannot clear layout reservation token: $clean_repository"
}

emit_layout_path_mappings() {
  transaction_directory=$1
  transaction_manifest="$transaction_directory/manifest.env"
  if [ -f "$transaction_manifest" ] && [ ! -L "$transaction_manifest" ]; then
    transaction_final_backup=$(transaction_value final_backup "$transaction_manifest")
  else
    transaction_final_backup=''
  fi
  while IFS= read -r mapping_file; do
    [ -n "$mapping_file" ] || continue
    old_root=$(transaction_value old_root "$mapping_file")
    clean_root=$(transaction_value clean_root "$mapping_file")
    backup_root=$(transaction_value backup_root "$mapping_file")
    if [ -d "$clean_root" ]; then
      source_root="$clean_root"
    elif [ -d "$backup_root" ]; then
      source_root="$backup_root"
    else
      source_root="$old_root"
    fi
    if [ -d "$old_root" ]; then
      legacy_checkpoint_root="$old_root"
    elif [ -d "$backup_root" ]; then
      legacy_checkpoint_root="$backup_root"
    elif [ -d "$transaction_final_backup/$(basename "$old_root")" ]; then
      legacy_checkpoint_root="$transaction_final_backup/$(basename "$old_root")"
    else
      legacy_checkpoint_root="$source_root"
    fi
    while IFS= read -r store_metadata; do
      [ -n "$store_metadata" ] || continue
      source_task=$(dirname "$store_metadata")
      relative_task=${source_task#"$source_root"/}
      old_task="$old_root/$relative_task"
      new_task="$clean_root/$relative_task"
      printf 'old_task_path=%s\n' "$old_task"
      printf 'new_task_path=%s\n' "$new_task"
      printf 'new_state_path=%s\n' "$new_task/state.md"
    done <<EOF
$(metadata_files "$source_root")
EOF
    while IFS= read -r source_checkpoint; do
      [ -n "$source_checkpoint" ] || continue
      relative_checkpoint=${source_checkpoint#"$legacy_checkpoint_root"/}
      case "$relative_checkpoint" in *.md) new_checkpoint="$clean_root/$relative_checkpoint" ;; *) new_checkpoint="$clean_root/$relative_checkpoint.md" ;; esac
      printf 'old_checkpoint_path=%s\n' "$old_root/$relative_checkpoint"
      printf 'new_checkpoint_path=%s\n' "$new_checkpoint"
    done <<EOF
$(find "$legacy_checkpoint_root" -path '*/checkpoints/*' -type f -print | LC_ALL=C sort)
EOF
  done <<EOF
$(transaction_mapping_files "$transaction_directory")
EOF
}

migrate_layout_execute() {
  if [ -z "$migration_old_roots" ]; then
    printf '%s\n' 'migration=not-needed'
    return
  fi
  migration_transaction=$(mktemp -d "$notes_root/.sb-notes-layout-transaction.XXXXXX") || die "cannot create layout migration transaction under $notes_root"
  chmod 700 "$migration_transaction" || die "cannot secure layout migration transaction: $migration_transaction"
  final_backup="$notes_root/.sb-notes-layout-backup-$(date -u '+%Y%m%dT%H%M%SZ')-$$"
  write_transaction_manifest "$migration_transaction" prepared "$final_backup"
  mkdir "$migration_transaction/staged" "$migration_transaction/backup" "$migration_transaction/failed" "$migration_transaction/mappings" || die "cannot prepare layout migration transaction: $migration_transaction"
  chmod 700 "$migration_transaction/staged" "$migration_transaction/backup" "$migration_transaction/failed" "$migration_transaction/mappings"

  mapping_number=0
  while IFS= read -r old_repository; do
    [ -n "$old_repository" ] || continue
    mapping_number=$((mapping_number + 1))
    old_repo_key=$(basename "$old_repository")
    canonical_identity=$(repository_canonical_identity "$old_repository")
    clean_repo_key=$(clean_repo_key_from_identity "$canonical_identity")
    staged_repository="$migration_transaction/staged/$clean_repo_key"
    clean_repository="$notes_root/$clean_repo_key"
    backup_repository="$migration_transaction/backup/$old_repo_key"
    write_transaction_mapping "$migration_transaction" "$mapping_number" "$old_repository" "$clean_repository" "$staged_repository" "$backup_repository" "$canonical_identity" "$old_repo_key" "$clean_repo_key"
  done <<EOF
$migration_old_roots
EOF

  while IFS= read -r mapping_file; do
    [ -n "$mapping_file" ] || continue
    old_repository=$(transaction_value old_root "$mapping_file")
    staged_repository=$(transaction_value stage_root "$mapping_file")
    old_repo_key=$(transaction_value old_repo_key "$mapping_file")
    clean_repo_key=$(transaction_value clean_repo_key "$mapping_file")
    copy_repository_to_stage "$old_repository" "$staged_repository"
    rewrite_repository_metadata_key "$staged_repository" "$old_repo_key" "$clean_repo_key"
  done <<EOF
$(transaction_mapping_files "$migration_transaction")
EOF

  while IFS= read -r destination_mapping; do
    [ -n "$destination_mapping" ] || continue
    staged_repository=$(transaction_value stage_root "$destination_mapping")
    while IFS= read -r reference_mapping; do
      [ -n "$reference_mapping" ] || continue
      reference_source=$(transaction_value old_root "$reference_mapping")
      reference_final=$(transaction_value clean_root "$reference_mapping")
      rewrite_checkpoint_references "$staged_repository" "$reference_source" "$reference_final"
      rewrite_repository_markdown "$staged_repository" "$reference_source" "$reference_final"
    done <<EOF
$(transaction_mapping_files "$migration_transaction")
EOF
    rename_extensionless_checkpoints "$staged_repository"
    validate_repository_store "$staged_repository" "$(transaction_value clean_repo_key "$destination_mapping")" "$(transaction_value canonical_identity "$destination_mapping")"
  done <<EOF
$(transaction_mapping_files "$migration_transaction")
EOF
  write_transaction_manifest "$migration_transaction" staged "$final_backup"
  write_transaction_manifest "$migration_transaction" publishing "$final_backup"

  while IFS= read -r mapping_file; do
    [ -n "$mapping_file" ] || continue
    publish_staged_repository "$(transaction_value stage_root "$mapping_file")" "$(transaction_value clean_root "$mapping_file")" "$(transaction_value clean_repo_key "$mapping_file")" "$(transaction_value canonical_identity "$mapping_file")" "$mapping_file"
  done <<EOF
$(transaction_mapping_files "$migration_transaction")
EOF
  write_transaction_manifest "$migration_transaction" published "$final_backup"
  write_transaction_manifest "$migration_transaction" backing-up "$final_backup"

  while IFS= read -r mapping_file; do
    [ -n "$mapping_file" ] || continue
    old_repository=$(transaction_value old_root "$mapping_file")
    backup_repository=$(transaction_value backup_root "$mapping_file")
    [ ! -e "$backup_repository" ] || die "layout migration backup destination already exists: $backup_repository"
    mv "$old_repository" "$backup_repository" || die "cannot move old repository layout into backup: $old_repository"
  done <<EOF
$(transaction_mapping_files "$migration_transaction")
EOF
  write_transaction_manifest "$migration_transaction" backed-up "$final_backup"

  while IFS= read -r mapping_file; do
    [ -n "$mapping_file" ] || continue
    validate_repository_store "$(transaction_value clean_root "$mapping_file")" "$(transaction_value clean_repo_key "$mapping_file")" "$(transaction_value canonical_identity "$mapping_file")"
  done <<EOF
$(transaction_mapping_files "$migration_transaction")
EOF
  write_transaction_manifest "$migration_transaction" validated "$final_backup"

  [ ! -e "$final_backup" ] || die "layout migration backup destination already exists: $final_backup"
  mv "$migration_transaction/backup" "$final_backup" || die "cannot finalize layout migration backup: $final_backup"
  emit_layout_path_mappings "$migration_transaction"
  rm -rf "$migration_transaction"
  migration_transaction=''
  printf '%s\n' 'migration=completed'
}

migrate_layout() {
  migration_mode=''
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) [ -z "$migration_mode" ] || usage; migration_mode=dry-run; shift ;;
      --execute) [ -z "$migration_mode" ] || usage; migration_mode=execute; shift ;;
      *) usage ;;
    esac
  done
  [ -n "$migration_mode" ] || usage
  begin_notes_operation no
  migrate_layout_preflight
  if [ "$migration_mode" = dry-run ]; then
    dry_transaction=$(mktemp -d "$notes_root/.sb-notes-layout-dry-run.XXXXXX") || die "cannot stage dry-run mappings under $notes_root"
    mkdir "$dry_transaction/mappings"
    dry_number=0
    printf 'migration=%s\n' dry-run
    while IFS= read -r old_repository; do
      [ -n "$old_repository" ] || continue
      dry_number=$((dry_number + 1))
      old_repo_key=$(basename "$old_repository")
      canonical_identity=$(repository_canonical_identity "$old_repository")
      clean_repo_key=$(clean_repo_key_from_identity "$canonical_identity")
      write_transaction_mapping "$dry_transaction" "$dry_number" "$old_repository" "$notes_root/$clean_repo_key" '' '' "$canonical_identity" "$old_repo_key" "$clean_repo_key"
      printf 'old_repo_root=%s\n' "$old_repository"
      printf 'new_repo_root=%s\n' "$notes_root/$clean_repo_key"
    done <<EOF
$migration_old_roots
EOF
    emit_layout_path_mappings "$dry_transaction"
    rm -rf "$dry_transaction"
    release_layout_lock
    return
  fi
  migrate_layout_execute
  release_layout_lock
}

artifact() {
  task_path=''
  artifact_name=''
  artifact_path=''
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --task-path) need_value "$@"; task_path=$2; shift 2 ;;
      --name) need_value "$@"; artifact_name=$2; shift 2 ;;
      --path) need_value "$@"; artifact_path=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  [ -n "$task_path" ] && [ -n "$artifact_name" ] && [ -n "$artifact_path" ] || usage
  require_short_text 'artifact name' "$artifact_name"
  require_single_line 'artifact path' "$artifact_path"
  case "$artifact_path" in /*) ;; *) die "artifact path must be absolute: $artifact_path" ;; esac
  begin_notes_operation no
  task_path=$(validate_task_store "$notes_root" "$task_path")
  artifact_dir="$task_path/artifacts"
  ensure_private_directory "$artifact_dir"
  artifact_file=$(mktemp "$artifact_dir/$(slug "$artifact_name")-$(short_hash "$artifact_name")-XXXXXX") || die "cannot create artifact reference in $artifact_dir"
  {
    printf 'name=%s\n' "$artifact_name"
    printf 'path=%s\n' "$artifact_path"
    printf 'recorded_at=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  } > "$artifact_file"
  chmod 600 "$artifact_file"
  release_layout_lock
  printf 'artifact_path=%s\n' "$artifact_file"
}

command=${1:-}
case "$command" in
  init) shift; init_task "$@" ;;
  resolve) shift; resolve_task "$@" ;;
  read-state) shift; read_state "$@" ;;
  replace-state) shift; replace_state "$@" ;;
  checkpoint) shift; checkpoint "$@" ;;
  artifact) shift; artifact "$@" ;;
  migrate-layout) shift; migrate_layout "$@" ;;
  *) usage ;;
esac
